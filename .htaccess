
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Block access to sensitive Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(/|$) - [F,L,NC]

    # Protect sensitive files
    <FilesMatch "^(\.env|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$">
        Require all denied
    </FilesMatch>

    # Allow only CMS uploads inside storage
    RewriteRule ^storage/(?!uploads/) - [F,L,NC]

    # Redirect /public URLs to root
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Serve public assets
    RewriteRule ^(css|js|img|images|font|fonts|webfonts|storage)(/.*)?$ public/$0 [L,NC]

    # Serve favicon and robots.txt
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L,NC]

    # Laravel front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
